{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-paper/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-production/types/**/*.ts",
    ".next-research/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-vercel/types/**/*.ts",
    ".next-vercel/dev/types/**/*.ts",
    ".next-vercel-check/types/**/*.ts",
    ".next-vercel-check/dev/types/**/*.ts",
    ".next-paper/dev/types/**/*.ts",
    ".next-cloud/types/**/*.ts",
    ".next-cloud/dev/types/**/*.ts",
    ".next-styleqa/types/**/*.ts",
    ".next-styleqa/dev/types/**/*.ts",
    ".next-accountqa/types/**/*.ts",
    ".next-accountqa/dev/types/**/*.ts",
    ".next-capitalqa/types/**/*.ts",
    ".next-capitalqa/dev/types/**/*.ts",
    ".next-capital-build/types/**/*.ts",
    ".next-capital-build/dev/types/**/*.ts",
    ".next-broad-check/types/**/*.ts",
    ".next-broad-check/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
