{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs"
    }
  },
  "crons": [
    { "path": "/api/cron/blend", "schedule": "35 13 * * 1-5" },
    { "path": "/api/cron/blend", "schedule": "35 14 * * 1-5" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
