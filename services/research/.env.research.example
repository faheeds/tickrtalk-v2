# Copy these owner-only settings into the app root .env.research.
# bootstrap.py generates the private service token and local connection.
RESEARCH_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=openai
# Choose supported models available to your provider account.
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
OPENAI_API_KEY=
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
RESEARCH_TIMEOUT_SECONDS=1200
RESEARCH_DAILY_LIMIT=20
RESEARCH_BIND=127.0.0.1
RESEARCH_PORT=8001
